.owner-page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.rest-panel { margin-top: 24rpx; }
button.rest-toggle.ui-button[size="default"] { justify-content: space-between; padding: 0 24rpx; font-size: 30rpx; }
.rest-toggle text:last-child { font-size: 25rpx; font-weight: 400; }
.rest-content { margin-top: 16rpx; padding: 26rpx; border: 2rpx solid #dce6e0; border-radius: 24rpx; background: #fff; }
.rest-time-label { margin-top: 24rpx; color: #526c60; font-size: 27rpx; }
.rest-picker-row { display: flex; gap: 16rpx; margin-top: 10rpx; }
.rest-picker-row picker { flex: 1; padding: 20rpx 12rpx; border: 2rpx solid #dce6e0; border-radius: 16rpx; background: #f8faf9; text-align: center; font-size: 28rpx; }
.rest-note { box-sizing: border-box; width: 100%; min-height: 110rpx; margin-top: 12rpx; padding: 20rpx; border: 2rpx solid #dce6e0; border-radius: 16rpx; font-size: 28rpx; }
.rest-preview { margin: 20rpx 0; padding: 22rpx; border-radius: 18rpx; background: #fff8e9; overflow-wrap: anywhere; }
.rest-preview text { color: #826846; font-size: 24rpx; }
.rest-preview view { margin-top: 8rpx; color: #5c472d; font-size: 30rpx; font-weight: 600; }
.rest-block { margin-top: 22rpx; padding-top: 20rpx; border-top: 2rpx solid #edf1ee; }
.rest-block-heading { color: #26734f; font-size: 26rpx; }
.rest-block-time { margin-top: 6rpx; font-size: 25rpx; color: #61746b; }
.rest-block-message { margin: 12rpx 0 16rpx; font-size: 29rpx; overflow-wrap: anywhere; }
.share-panel { margin-top: 18rpx; }
button.share-toggle.ui-button[size="default"] { justify-content: space-between; padding: 0 24rpx; border-color: #e1c59e; background: #fff8e9; color: #744c34; font-size: 30rpx; }
.share-toggle text:last-child { font-size: 25rpx; font-weight: 400; }
.share-content { position: relative; margin-top: 16rpx; padding: 26rpx; border: 2rpx solid #ead5b4; border-radius: 24rpx; background: #fffaf0; overflow: hidden; }
.share-intro { display: flex; align-items: center; gap: 16rpx; }
.share-intro > view { flex: 1; min-width: 0; }
.share-angel { flex: 0 0 auto; width: 128rpx; height: 128rpx; }
.share-animation-preview-card { margin-top: 22rpx; padding: 16rpx; border: 2rpx solid #ead5b4; border-radius: 20rpx; background: #fff; }
.share-animation-preview-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 12rpx; color: #70452f; font-size: 27rpx; font-weight: 600; }
.share-animation-preview-heading text:last-child { color: #9a7c64; font-size: 22rpx; font-weight: 400; white-space: nowrap; }
.share-animation-preview { overflow: hidden; border-radius: 14rpx; background: #fff8ec; }
.share-booked-demo-gif { display: block; width: 100%; height: auto; }
.share-animation-preview-caption { margin-top: 10rpx; color: #806f63; font-size: 23rpx; line-height: 1.5; text-align: center; }
.share-presets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 22rpx; }
button.share-preset[size="mini"] { display: flex; align-items: center; justify-content: center; width: 100%; height: 68rpx; margin: 0; padding: 0; border: 2rpx solid #ead5b4; border-radius: 16rpx; background: #fffdf8; color: #80654e; font-size: 26rpx; line-height: 1.3; }
button.share-preset.is-active[size="mini"] { border-color: #c88962; background: #f7e5cb; color: #70452f; font-weight: 600; }
.share-date-range { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 18rpx; }
.share-date-picker { display: flex; align-items: center; justify-content: center; min-height: 76rpx; padding: 8rpx 12rpx; border: 2rpx solid #ead5b4; border-radius: 15rpx; background: #fffdf8; color: #704f39; font-size: 25rpx; text-align: center; }
.share-date-picker text { margin-right: 10rpx; color: #a27d60; }
.share-load { margin-top: 18rpx; }
.share-schedule-preview { margin-top: 20rpx; padding: 22rpx; border: 2rpx dashed #dfbd8e; border-radius: 20rpx; background: #fff; }
.share-range-copy { color: #70452f; font-size: 28rpx; font-weight: 600; }
.share-day { margin-top: 18rpx; }
.share-day-title { color: #8b5d3f; font-size: 26rpx; font-weight: 600; }
.share-times { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 9rpx; }
.share-times text { padding: 8rpx 14rpx; border-radius: 999rpx; background: #f8ead4; color: #5f4838; font-size: 25rpx; font-weight: 600; }
.share-empty { margin-top: 8rpx; color: #8d7b6e; font-size: 25rpx; }
.share-empty.all-day-available { color: #246a53; font-size: 28rpx; font-weight: 700; }
.share-buffer-note { margin-top: 20rpx; color: #8d7b6e; font-size: 23rpx; }
.share-generate { margin-top: 20rpx; }
.share-poster-result { margin-top: 22rpx; padding: 18rpx; border-radius: 20rpx; background: #fff; }
.share-poster-stage { position: relative; overflow: hidden; border-radius: 14rpx; }
.share-poster { display: block; width: 100%; border-radius: 14rpx; box-shadow: 0 8rpx 28rpx rgba(112, 69, 47, 0.12); }
.share-poster-motion { position: absolute; inset: 0; pointer-events: none; }
.share-motion-cover { position: absolute; left: 12%; width: 76%; background: linear-gradient(180deg, rgba(255,246,228,0) 0%, rgba(255,246,228,.88) 13%, rgba(255,246,228,.97) 84%, rgba(255,246,228,0) 100%); }
.share-motion-cover-1 { top: 68%; height: 25%; }
.share-motion-cover-2 { top: 60%; height: 24%; }
.share-motion-cover-3 { top: 75%; height: 17%; }
.share-motion-flight { position: absolute; left: 38.4%; top: 69.4%; width: 23.2%; height: 18.75%; transform-origin: top left; will-change: transform, opacity; animation: shareAngelFlyIn 5.2s linear both; }
.share-motion-flight-1, .share-motion-flight-2 { left: 38.4%; top: 69.4%; width: 23.2%; height: 18.75%; }
.share-motion-flight-3 { left: 42.5%; top: 76.6%; width: 15%; height: 12.1%; animation-name: shareAngelFlyInThreeDays; }
.share-motion-original, .share-motion-flapping { position: absolute; inset: 0; width: 100%; height: 100%; }
.share-motion-original { animation: shareAngelOriginal 5.2s ease-in-out both; }
.share-motion-flapping { opacity: 0; animation: shareAngelFlapping 5.2s ease-in-out both; }
.share-motion-expression { position: absolute; left: 38.4%; top: 69.4%; width: 23.2%; height: 18.75%; opacity: 0; animation: shareAngelExpression 5.2s ease-in-out both; }
.share-motion-expression-1, .share-motion-expression-2 { left: 38.4%; top: 69.4%; width: 23.2%; height: 18.75%; }
.share-motion-expression-3 { left: 42.5%; top: 76.6%; width: 15%; height: 12.1%; }
.share-motion-bubble { position: absolute; left: 16.7%; top: 85.1%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 66.7%; height: 5.5%; padding: 0 10rpx; border: 2rpx solid #ead7b7; border-radius: 999rpx; background: #fffdfa; color: #70452f; font-size: 29rpx; font-weight: 700; white-space: nowrap; opacity: 0; animation: shareBubbleSpeak .5s ease-out 4.25s both; }
.share-motion-bubble-2 { top: 78.1%; }
.share-motion-bubble-3 { top: 85.75%; }
@keyframes shareAngelFlyIn {
  0% { opacity: 1; transform: translate(-148%, -354%) scale(.32) rotate(-8deg); }
  19% { opacity: 1; transform: translate(-156%, -302%) scale(.416) rotate(-4deg); }
  29% { opacity: 1; transform: translate(-157%, -192%) scale(.576) rotate(-1deg); }
  38.5% { opacity: 1; transform: translate(-131%, -68%) scale(.744) rotate(2deg); }
  48% { opacity: 1; transform: translate(-68%, -2%) scale(.904) rotate(3deg); }
  58% { opacity: 1; transform: translate(-8%, 1%) scale(.992) rotate(1deg); }
  76%, 94% { opacity: 1; transform: translate(0, 0) scale(1) rotate(0); }
  100% { opacity: 0; transform: translate(0, 0) scale(1) rotate(0); }
}
@keyframes shareAngelFlyInThreeDays {
  0% { opacity: 1; transform: translate(-256%, -608%) scale(.494) rotate(-8deg); }
  19% { opacity: 1; transform: translate(-268%, -524%) scale(.57) rotate(-4deg); }
  29% { opacity: 1; transform: translate(-269%, -338%) scale(.681) rotate(-1deg); }
  38.5% { opacity: 1; transform: translate(-224%, -124%) scale(.817) rotate(2deg); }
  48% { opacity: 1; transform: translate(-116%, -6%) scale(.929) rotate(3deg); }
  58% { opacity: 1; transform: translate(-12%, 2%) scale(.99) rotate(1deg); }
  76%, 94% { opacity: 1; transform: translate(0, 0) scale(1) rotate(0); }
  100% { opacity: 0; transform: translate(0, 0) scale(1) rotate(0); }
}
@keyframes shareAngelOriginal {
  0%, 13% { opacity: 1; }
  19%, 100% { opacity: 0; }
}
@keyframes shareAngelFlapping {
  0%, 10% { opacity: 0; }
  17%, 72% { opacity: 1; }
  80%, 100% { opacity: 0; }
}
@keyframes shareAngelExpression {
  0%, 73% { opacity: 0; transform: scale(.9); }
  82%, 94% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(1); }
}
@keyframes shareBubbleSpeak { from { opacity: 0; transform: translateY(10rpx) scale(.94); } to { opacity: 1; transform: translateY(0) scale(1); } }
