.booking-page { padding-top: 24rpx; }
.step-bar { display: flex; align-items: center; justify-content: center; margin: 0 0 24rpx; font-size: 28rpx; color: #738479; }
.step-item { display: flex; align-items: center; }
.step-number { display: flex; width: 40rpx; height: 40rpx; margin-right: 10rpx; align-items: center; justify-content: center; border-radius: 50%; background: #dce6df; font-size: 26rpx; }
.step-item.is-active { color: #174c3d; font-weight: 600; }
.is-active .step-number, .is-done .step-number { background: #26734f; color: #fff; }
.step-line { width: 70rpx; height: 2rpx; margin: 0 22rpx; background: #d3e1d8; }
.booking-summary { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 26rpx; background: #fff; border: 1rpx solid #dce6e0; border-radius: 22rpx; }
.summary-label { color: #687e70; font-size: 28rpx; }
.summary-name { font-size: 34rpx; font-weight: 600; margin-top: 4rpx; }
.duration { color: #326947; font-size: 30rpx; margin-left: 14rpx; white-space: nowrap; }
.booking-page .section-heading { margin: 28rpx 0 18rpx; }
.date-strip { width: 100%; }
.date-row { display: flex; width: 100%; padding-bottom: 2rpx; }
button.date-card.ui-button[size="default"] {
  flex: 1; width: 0; height: 112rpx; min-width: 0; margin: 0 8rpx 0 0;
  flex-direction: column; border: 2rpx solid transparent; border-radius: 18rpx;
  background: #fff; color: #4d6858;
}
button.date-card.ui-button[size="default"]:last-child { margin-right: 0; }
button.date-card.ui-button.is-selected[size="default"] { background: #174c3d; color: #fff; border-color: #174c3d; }
.date-weekday { font-size: 26rpx; font-weight: 400; }
.date-day { margin-top: 8rpx; font-size: 36rpx; font-weight: 600; }
.time-panel { background: #fff; padding: 24rpx; border-radius: 24rpx; border: 1rpx solid #dce6e0; }
.time-fields { display: flex; margin: 0 -6rpx; }
.time-picker { flex: 1; width: 0; min-width: 0; margin: 0 6rpx; }
.time-field {
  display: flex; height: 104rpx; min-width: 0; padding: 0 16rpx; align-items: center;
  border: 2rpx solid #bfd4c5; background: #f1f7f2; border-radius: 18rpx;
}
.period-time-field { justify-content: space-between; }
.period-value { color: #174c3d; font-size: 42rpx; font-weight: 600; white-space: nowrap; }
.number-time-field { padding-right: 10rpx; }
.time-number-input {
  flex: 1; width: 0; min-width: 0; height: 100%; padding: 0;
  color: #174c3d; font-size: 52rpx; font-weight: 600; line-height: 104rpx;
  text-align: center; font-variant-numeric: tabular-nums;
}
.time-unit-trigger { display: flex; height: 100%; padding-left: 4rpx; align-items: center; flex-shrink: 0; }
.time-unit, .chevron { font-size: 28rpx; font-weight: 400; margin-left: 4rpx; color: #5f7868; }
.time-status { display: flex; align-items: flex-start; margin-top: 22rpx; color: #65796c; font-size: 30rpx; min-height: 45rpx; }
.status-symbol { margin-right: 12rpx; font-weight: 600; }
.time-status.available { color: #26734f; }
.time-status.unavailable, .time-status.error { color: #a14c2e; }
.booking-note { color: #61746b; font-size: 28rpx; margin-top: 20rpx; line-height: 1.7; }
.chosen-time { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10rpx; margin: 20rpx 0; padding: 18rpx 22rpx; border-radius: 18rpx; background: #e3eee6; color: #305d43; font-size: 30rpx; }
.form-card { background: #fff; border: 1rpx solid #dce6e0; border-radius: 24rpx; padding: 0 24rpx; }
.field { display: block; padding: 20rpx 0; border-bottom: 1rpx solid #e6ede8; }
.field:last-child { border-bottom: 0; }
.field-label { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.optional { font-size: 26rpx; font-weight: 400; color: #6c7b72; margin-left: 12rpx; }
.field input { height: 50rpx; width: 100%; font-size: 32rpx; line-height: 1.5; }
.input-placeholder { color: #829187; }
.notification-card { margin-top: 20rpx; padding: 8rpx 24rpx 18rpx; border: 1rpx solid #dce6e0; border-radius: 24rpx; background: #fff; }
.switch-row { display: flex; align-items: center; justify-content: space-between; min-height: 84rpx; font-size: 30rpx; }
.notification-note { color: #6c7b72; font-size: 26rpx; line-height: 1.6; }
.dual-actions { display: flex; gap: 18rpx; }
.dual-actions button.secondary-button.ui-button[size="default"] { flex: 1; width: 0; }
.dual-actions button.primary-button.ui-button[size="default"] { flex: 1.55; width: 0; }
.success-card { background: #fff; border: 1rpx solid #dce6e0; border-radius: 28rpx; padding: 40rpx 26rpx; margin-top: 30rpx; text-align: center; }
.success-mark { display: flex; width: 92rpx; height: 92rpx; margin: 0 auto 24rpx; justify-content: center; align-items: center; border-radius: 50%; background: #26734f; color: #fff; font-size: 52rpx; }
.success-title { font-size: 44rpx; font-weight: 600; }
.success-copy { color: #6c7b72; font-size: 30rpx; margin-top: 12rpx; }
.receipt { margin-top: 32rpx; }
.receipt view { display: flex; justify-content: space-between; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid #e6ede8; font-size: 28rpx; color: #677f6e; text-align: left; }
.receipt-value, .receipt-code { color: #203a32; text-align: right; flex: 1; overflow-wrap: anywhere; }
.time-selector-layer { position: fixed; z-index: 30; inset: 0; }
.time-selector-mask { position: absolute; inset: 0; background: rgba(16, 29, 24, .58); }
.time-selector-sheet {
  position: absolute; left: 0; right: 0; bottom: 0; height: 650rpx;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0; background: #fff;
}
.time-selector-sheet.is-compact { height: 330rpx; }
.time-selector-header {
  display: flex; height: 104rpx; align-items: center; justify-content: space-between;
  border-bottom: 1rpx solid #e1e9e4;
}
.time-selector-title { font-size: 36rpx; font-weight: 600; color: #203a32; }
.time-selector-close { padding: 20rpx 0 20rpx 30rpx; color: #26734f; font-size: 32rpx; }
.time-selector-options { height: 520rpx; }
.is-compact .time-selector-options { height: 210rpx; }
.time-selector-option {
  display: flex; height: 104rpx; padding: 0 22rpx; align-items: center; justify-content: space-between;
  border-bottom: 1rpx solid #edf1ee; color: #29463d; font-size: 40rpx;
}
.time-selector-option.is-selected { color: #174c3d; font-size: 42rpx; font-weight: 600; background: #eef6f0; }
.selector-check { width: 42rpx; color: #26734f; text-align: center; }
@media (max-width: 350px) {
  .time-field { padding: 0 12rpx; }
  .time-number-input { font-size: 48rpx; }
  .period-value { font-size: 38rpx; }
  .time-unit, .chevron { font-size: 26rpx; }
}
