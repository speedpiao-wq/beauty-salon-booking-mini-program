.page-intro { padding: 30rpx 28rpx; border-radius: 28rpx; background: #174c3d; color: #fff; }
.intro-eyebrow { color: #d8e7de; font-size: 26rpx; }
.intro-title { margin-top: 4rpx; font-size: 42rpx; font-weight: 600; }
.intro-copy { margin-top: 10rpx; color: #d8e7de; font-size: 28rpx; }
.updated-time { margin-top: 8rpx; color: #b9d2c3; font-size: 24rpx; }
.view-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 22rpx; }
button.view-tab[size="default"] { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 76rpx; margin: 0; padding: 0; border: 2rpx solid #dce6e0; border-radius: 18rpx; background: #fff; color: #526c60; font-size: 29rpx; line-height: 1.3; }
button.view-tab.is-active[size="default"] { border-color: #26734f; background: #edf5ef; color: #174c3d; font-weight: 600; }
.view-hint { margin-top: 12rpx; color: #71897b; font-size: 25rpx; line-height: 1.55; }
.state-card { margin-top: 24rpx; padding: 34rpx 28rpx; border: 2rpx solid #dce6e0; border-radius: 24rpx; background: #fff; color: #61746b; text-align: center; }
.empty-title { color: #203a32; font-size: 34rpx; font-weight: 600; }
.empty-copy { margin-top: 8rpx; }
.appointment-list { margin-top: 24rpx; }
.swipe-row { position: relative; margin-bottom: 18rpx; overflow: hidden; border-radius: 24rpx; background: transparent; }
.swipe-actions { position: absolute; inset: 0 0 0 auto; display: flex; width: 176rpx; align-items: stretch; justify-content: stretch; }
button.swipe-action-button[size="default"] { display: flex; align-items: center; justify-content: center; min-width: 0; width: 176rpx; height: 100%; margin: 0; padding: 0 18rpx; border: 0; border-radius: 0; background: #9b3b3b; color: #fff; font-size: 28rpx; line-height: 1.35; }
button.swipe-delete-button[size="default"] { background: #68736d; }
.appointment-card { position: relative; z-index: 1; margin: 0; padding: 26rpx; border: 2rpx solid #dce6e0; border-radius: 24rpx; background: #fff; transform: translateX(0); transition: transform .18s ease; }
.appointment-card.is-open { transform: translateX(-176rpx); }
.appointment-card.status-confirmed { border-color: #7da591; background: #edf5ef; }
.appointment-card.status-cancelled_by_customer,
.appointment-card.status-cancelled_by_owner { border-color: #d9d9d9; background: #f5f5f5; }
.appointment-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.service-name { flex: 1; min-width: 0; font-size: 34rpx; font-weight: 600; }
.status-chip { padding: 6rpx 14rpx; border-radius: 999rpx; background: #e8eee9; color: #526c60; font-size: 24rpx; white-space: nowrap; }
.status-confirmed .status-chip { background: #26734f; color: #fff; }
.status-cancelled_by_customer .status-chip,
.status-cancelled_by_owner .status-chip { background: #7a7a7a; color: #fff; }
.appointment-time { margin-top: 14rpx; color: #326947; font-size: 32rpx; font-weight: 600; }
.status-copy { margin-top: 14rpx; color: #244f40; }
.booking-code { margin-top: 16rpx; color: #71897b; font-size: 25rpx; }
.refresh-button { margin-bottom: 14rpx; }
